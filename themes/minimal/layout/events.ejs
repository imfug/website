<%
  var tag = site.tags.findOne({ name: 'event' });
  var events = tag ? tag.posts.sort('-date') : [];
%>
<article>
  <h1><%= page.title %></h1>
  <ul class="post-list events">
  <% events.each(function(post){ %>
    <li>
      <time class="meta" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MMMM D, YYYY') %></time>
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </li>
  <% }) %>
  </ul>
</article>

<article data-pagefind-body>
  <h1><%= page.title %></h1>
  <time class="small text-body-secondary" datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
  <% if (page.banner) { %><img class="img-fluid rounded mt-3" src="<%- url_for(page.banner) %>" alt=""><% } %>
  <div class="content mt-3"><%- page.content %></div>
</article>

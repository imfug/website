<article data-pagefind-body>
  <h1><%= page.title %></h1>
  <time class="meta" datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
  <% if (page.banner) { %><img class="banner" src="<%- url_for(page.banner) %>" alt=""><% } %>
  <%- partial('_partial/toc') %>
  <div class="content"><%- page.content %></div>
</article>

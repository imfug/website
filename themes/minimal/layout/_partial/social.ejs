<%
  var icons = {
    youtube: { label: 'YouTube', svg: '<path fill-rule="evenodd" d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15.1V8.9l5.7 3.1z"/>' },
    linkedin: { label: 'LinkedIn', svg: '<path fill-rule="evenodd" d="M20.4 2H3.6A1.6 1.6 0 0 0 2 3.6v16.8A1.6 1.6 0 0 0 3.6 22h16.8a1.6 1.6 0 0 0 1.6-1.6V3.6A1.6 1.6 0 0 0 20.4 2zM8 19H5V9.5h3zM6.5 8.2a1.75 1.75 0 1 1 0-3.5 1.75 1.75 0 0 1 0 3.5zM19 19h-3v-4.6c0-1.1 0-2.5-1.5-2.5s-1.7 1.1-1.7 2.4V19h-3V9.5h2.9v1.3c.4-.8 1.4-1.6 2.9-1.6 3.1 0 3.4 2 3.4 4.6z"/>' },
    email: { label: 'Email', svg: '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 6.5 9 6.5 9-6.5"/></g>' }
  };
  var links = Object.keys(config.social || {}).filter(function(k){ return icons[k] && config.social[k]; });
%>
<% if (links.length) { %>
<div class="social">
  <% links.forEach(function(k){ %><a href="<%= config.social[k] %>" aria-label="<%= icons[k].label %>" title="<%= icons[k].label %>"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><%- icons[k].svg %></svg></a><% }) %>
</div>
<% } %>

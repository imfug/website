<!doctype html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <link rel="alternate" type="application/atom+xml" href="<%- url_for('atom.xml') %>">
  <script>document.documentElement.dataset.bsTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';</script>
  <%- css('css/bootstrap.min.css') %>
  <% if (config.custom_css !== false) { %><%- css('css/style.css') %><% } %>
</head>
<body>
  <div class="container-fluid custom-limit mx-auto">
    <div class="row">
      <aside class="sidebar col-md-3 py-3 px-3 border-end">
        <a class="brand d-block mb-2" href="<%- url_for('/') %>"><img src="<%- url_for('images/logo.png') %>" alt="<%= config.title %>"></a>
        <a class="site-title d-block fs-2 fw-bold text-body text-decoration-none" href="<%- url_for('/') %>"><%= config.title %></a>
        <% if (config.tagline) { %><p class="small text-body-secondary mt-1 mb-3"><%= config.tagline %></p><% } %>
        <nav class="nav flex-row flex-md-column flex-wrap nav-pills gap-1">
          <%
            var isCurrent = function(u){ return typeof u === 'string' && u.charAt(0) === '/' && is_current(u); };
            var link = function(label, u, extra){
              var cur = isCurrent(u);
              return '<a class="nav-link py-1' + (cur ? ' active' : '') + (extra || '') + '" href="' + url_for(u) + '"' + (cur ? ' aria-current="page"' : '') + '>' + label + '</a>';
            };
          %>
          <% Object.keys(config.menu || {}).forEach(function(k){ var v = config.menu[k]; %>
            <% if (typeof v === 'string') { %>
              <%- link(k, v) %>
            <% } else { var kids = Object.keys(v); %>
              <details class="nav-item" open>
                <summary class="nav-link py-1 text-primary" role="button"><%= k %> <span class="small">▾</span></summary>
                <div class="nav flex-column nav-pills ms-3 gap-1">
                  <% kids.forEach(function(c){ %><%- link(c, v[c]) %><% }) %>
                </div>
              </details>
            <% } %>
          <% }) %>
        </nav>
        <div id="search" class="mt-3"></div>
      </aside>
      <div class="col-md-9 px-md-4">
        <main class="py-4"><%- body %></main>
        <footer class="small text-body-secondary border-top py-3">
          <%= config.description %> · <a href="<%- url_for('atom.xml') %>">Feed</a>
        </footer>
      </div>
    </div>
  </div>
  <script>
    // Pagefind's index is built after `hexo generate` (npm run build), so it is absent under `hexo server`
    (function () {
      var base = '<%- url_for("pagefind/") %>';
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = base + 'pagefind-ui.css';
      document.head.appendChild(css);
      var js = document.createElement('script');
      js.src = base + 'pagefind-ui.js';
      js.onload = function () { new PagefindUI({ element: '#search', showSubResults: true, showImages: false }); };
      document.body.appendChild(js);
    })();
  </script>
</body>
</html>

<% page.posts.each(function(post){ %>
  <article class="post-card">
    <header>
      <time class="meta" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MMMM D, YYYY') %></time>
      <h2 class="post-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
    </header>
    <% if (post.banner) { %><a href="<%- url_for(post.path) %>"><img class="banner" src="<%- url_for(post.banner) %>" alt=""></a><% } %>
    <div class="content"><%- post.content %></div>
  </article>
<% }) %>
<%- paginator({ prev_text: '← Newer', next_text: 'Older →' }) %>

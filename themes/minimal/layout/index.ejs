<% if (config.hero && page.current === 1) { var hero = config.hero; %>
  <section class="hero">
    <h1><%= hero.title %></h1>
    <% if (hero.text) { %><div class="lead"><%- markdown(hero.text.replace(/([^\n])\n(?=[^\n])/g, '$1 ')).replace(/(href=")\/(?!\/)/g, '$1' + config.root) %></div><% } %>
    <% if (hero.buttons) { %><div class="buttons">
      <% Object.keys(hero.buttons).forEach(function(label, i){ %><a class="button<%= i === 0 ? ' primary' : '' %>" href="<%- url_for(hero.buttons[label]) %>"><%= label %></a><% }) %>
    </div><% } %>
  </section>
<% } %>
<% page.posts.each(function(post){ %>
  <article class="post-card">
    <header>
      <time class="meta" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MMMM D, YYYY') %></time>
      <h2 class="post-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
    </header>
    <% if (post.banner) { %><a href="<%- url_for(post.path) %>"><img class="banner" src="<%- url_for(post.banner) %>" alt=""></a><% } %>
    <div class="content"><%- post.content %></div>
  </article>
<% }) %>
<%- paginator({ prev_text: '← Newer', next_text: 'Older →' }) %>
